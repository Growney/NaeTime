@using MudBlazor
@inherits LayoutComponentBase
<div class="page">
    <div class="menu">
        <NaeTime.Client.BlazorWebApp.Components.Shared.Announcer></NaeTime.Client.BlazorWebApp.Components.Shared.Announcer>
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
 <MudPopoverProvider />
 <MudThemeProvider/>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
