@page "/"
@using NaeTime.Query.Abstractions.Models

@code{
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    private ISessionQueryHandler SessionQueryHandler { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var activeSession = await SessionQueryHandler.GetActiveSession();

        if(activeSession != null && activeSession.Type == SessionType.OpenPractice)
        {
            NavigationManager.NavigateTo($"/open-practice/{activeSession.Id}");
        }
        else
        {
            NavigationManager.NavigateTo("/session/list");
        }
    }
}