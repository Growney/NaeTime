@page "/pilot/{id:guid}"

@if (_pilot != null)
{
    <MudGrid Justify=Justify.Center>
        <MudItem xs=3>
            <MudIconButton Icon=@Icons.Material.Filled.ArrowLeft Href="/pilot/list"></MudIconButton>
            <MudPaper Class="p-4">
                <MudForm @bind-IsValid="_isValid">
                    <MudTextField T=string Value="_pilot.Firstname" ValueChanged="FirstnameChanged" Label="Firstname" Required="true"></MudTextField>
                    <MudTextField T=string Value="_pilot.Lastname" ValueChanged="LastnameChanged" Label="Lastname" Required="true"></MudTextField>
                    <MudTextField T=string Value=_pilot.Callsign ValueChanged="CallsignChanged" Label="Callsign" Required="true"></MudTextField>
                    @if(_pilot.HasBindingPhrase)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearBindingPhrase">Clear Binding Phrase</MudButton>
                    }
                    else
                    {
                        <MudTextField T=string Value=_pilot.BindingPhrase ValueChanged="ConfirmBindingPhrase" Label="Binding Phrase" Clearable=true></MudTextField>
                    }
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private IPilotQueryHandler PilotQueryHandler { get; set; } = null!;
    [Inject]
    private IPilotCommandHandler PilotCommandHandler { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private NaeTime.Client.Models.Pilot? _pilot;

    private bool _isValid = false;

    protected override async Task OnInitializedAsync()
    {
        _pilot = PilotProjector.Project(await PilotQueryHandler.GetPilotById(Id));
        if(_pilot == null)
        {
            NavigationManager.NavigateTo("/pilot/list");
        }
    } 
    private async Task FirstnameChanged(string? name)
    {
        if(_pilot == null)
        {
            return;
        }

        await PilotCommandHandler.RenamePilot(_pilot.Id, name, _pilot.Lastname);

        _pilot.Firstname = name;
    }

    private async Task LastnameChanged(string? name)
    {
        if (_pilot == null)
        {
            return;
        }
        await PilotCommandHandler.RenamePilot(_pilot.Id, _pilot.Firstname, name);
        _pilot.Lastname = name;
    }

    private async Task CallsignChanged(string? callsign)
    {
        if (_pilot == null)
        {
            return;
        }
        await PilotCommandHandler.ChangePilotCallsign(_pilot.Id, callsign);
        _pilot.Callsign = callsign;
    }

    private async Task ClearBindingPhrase()
    {
        if(_pilot == null)
        {
            return;
        }

        await PilotCommandHandler.RemovePilotBindingPhrase(_pilot.Id);
        _pilot.HasBindingPhrase = false;
        _pilot.BindingPhrase = string.Empty;
    }
    private async Task ConfirmBindingPhrase(string value)
    {
        if(_pilot == null)
        {
            return;
        }

        if(string.IsNullOrEmpty(value))
        {
            await PilotCommandHandler.RemovePilotBindingPhrase(Id);
            _pilot.HasBindingPhrase = false;
        }
        else
        {
            await PilotCommandHandler.ChangePilotBindingPhrase(Id, value);
            _pilot.HasBindingPhrase = true;
        }
    }
}
