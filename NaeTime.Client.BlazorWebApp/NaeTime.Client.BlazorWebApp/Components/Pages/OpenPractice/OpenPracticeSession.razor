@page "/open-practice/{id:guid}"
@using NaeTime.Hardware.Frequency



@if(_session != null)
{
    <div class="lane-container">
        @foreach (Models.OpenPracticeLane lane in _session.Lanes)
        {
            <div class="shadow rounded p-2" style="width: 190px">
                <table class="w-100">
                    <tbody>
                        <tr>
                            <td class="align-start" style="width:10px">
                                <MudSwitch T=bool Value="lane.IsEnabled" ValueChanged="x => EnabledChanged(x, lane.Lane)"></MudSwitch>
                            </td>
                            <td>
                                <div class="h4 text-start">
                                    @lane.Lane
                                </div>
                            </td>
                            <td>
                                <div class="h5 text-end">
                                    @lane.FrequencyInMHz<sup style="font-size:0.5em">MHz</sup>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="w-100">
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                        <MudButton>@(_pilots.FirstOrDefault(x => x.Id == lane.PilotId)?.Callsign ?? "[None]")</MudButton>
                        <MudMenu Label="@Icons.Material.Filled.ArrowDropDown">
                            <MudMenuItem Label="Clear" OnClick="x => OnPilotSelectionChanged(null, lane.Lane)"></MudMenuItem>
                            @foreach (NaeTime.Query.Abstractions.Models.Pilot pilot in GetUnassignedPilots(lane.Lane))
                            {
                                <MudMenuItem Label=@pilot.Callsign OnClick="x => OnPilotSelectionChanged(pilot.Id, lane.Lane)"></MudMenuItem>
                            }
                        </MudMenu>
                    </MudButtonGroup>
                    
                </div>
                <div>
                    <table class="w-100 mx-auto">
                        <tbody>
                            <tr>
                                <td class="w-50">
                                    <MudMenu Variant="Variant.Filled" Label="@(GetBandString(lane.BandId))" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                                        @foreach (NaeTime.Hardware.Frequency.Band band in NaeTime.Hardware.Frequency.Band.Bands)
                                        {
                                            <MudMenuItem Label="@band.ShortName" OnClick="() => ChangeFrequency([band.Id], [lane.FrequencyInMHz], lane.Lane)"></MudMenuItem>
                                        }
                                    </MudMenu>
                                </td>
                                <td class="w-50">
                                    @if (Band.Bands.Any(b => b.Id == lane.BandId))
                                    {
                                        <MudMenu Variant="Variant.Outlined" Label="@(GetFrequencyString(lane.BandId, lane.FrequencyInMHz))" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                                            @{
                                                Band band = Band.Bands.FirstOrDefault(b => b.Id == lane.BandId);
                                                foreach (NaeTime.Hardware.Frequency.BandFrequency bandFrequency in band.Frequencies)
                                                {
                                                    <MudMenuItem Label="@bandFrequency.Name" OnClick="() => ChangeFrequency([band.Id], [bandFrequency.FrequencyInMhz], lane.Lane)"></MudMenuItem>
                                                }
                                            }
                                        </MudMenu>
                                    }
                                    else
                                    {
                                        <MudNumericField T=int Value=lane.FrequencyInMHz Label="Custom" ValueChanged="x => ChangeFrequency(Enumerable.Empty<byte?>(), [x], lane.Lane)"></MudNumericField>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <table class="w-100">
                    <tbody>
                        <tr>
                            <td class="w-50">
                                <MudButton Variant=Variant.Filled Color=Color.Success Class="w-100 rounded-0 rounded-start" onclick="() => TriggerDetection(Guid.Empty)"><i class="fa-solid fa-stopwatch"></i></MudButton>
                            </td>
                            <td class="w-50">
                                <MudButton Variant=Variant.Filled Color=Color.Error Class="w-100 rounded-0 rounded-end" @onclick="() => TriggerInvalidation(Guid.Empty)"><i class="fa-solid fa-stopwatch"></i></MudButton>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
 
}


@code {

    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private IOpenPracticeCommandHandler OpenPracticeCommandHandler { get; set; } = null!;
    [Inject]
    private IOpenPracticeQueryHandler OpenPracticeQueryHandler { get; set; } = null!;
    [Inject]
    private IPilotQueryHandler PilotQueryHandler { get; set; } = null!;

    private Models.OpenPracticeSession? _session;
    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> _pilots = Enumerable.Empty<NaeTime.Query.Abstractions.Models.Pilot>();


    protected override async Task OnInitializedAsync()
    {
        _pilots = await PilotQueryHandler.GetAllPilots();

        _session = OpenPracticeSessionProjector.Project(await OpenPracticeQueryHandler.GetByIdAsync(Id));
    }
    private async Task EnabledChanged(bool enabled, byte lane)
    {
        if(_session == null)
        {
            return;
        }

        if(enabled)
        {
            await OpenPracticeCommandHandler.EnableLane(_session.Id, lane);
        }
        else
        {
            await OpenPracticeCommandHandler.DisableLane(_session.Id, lane);
        }
        _session.Lanes[lane].IsEnabled = enabled;
    }

    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> GetUnassignedPilots(byte lane)
    {
        if(_session == null)
        {
            return Enumerable.Empty<NaeTime.Query.Abstractions.Models.Pilot>();
        }

        Guid? currentPilot = _session.Lanes[lane].PilotId;

        IEnumerable<Guid> usedPilots = _session.Lanes.Where(x => x.PilotId.HasValue).Select(x => x.PilotId!.Value);

        return _pilots.Where(x => !usedPilots.Contains(x.Id) || x.Id == currentPilot);
    }
    private async Task OnPilotSelectionChanged(Guid? pilotId, byte lane)
    {
        if(_session == null)
        {
            return;
        }

        if (pilotId.HasValue)
        {
            await OpenPracticeCommandHandler.SetLanePilot(_session.Id, lane, pilotId.Value);
        }
        else
        {
            await OpenPracticeCommandHandler.ResetLanePilot(_session.Id, lane);
        }

        _session.Lanes[lane].PilotId = pilotId;
    }
    private string GetBandString(byte? bandId)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            return band.ShortName;
        }

        return $"Custom";
    }
    private string GetFrequencyString(byte? bandId, int frequencyInMhz)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            if (band.Frequencies.Any(x => x.FrequencyInMhz == frequencyInMhz))
            {
                BandFrequency frequency = band.Frequencies.First(x => x.FrequencyInMhz == frequencyInMhz);
                return frequency.Name;
            }
        }

        return $"{frequencyInMhz} Mhz";
    }
    private async Task ChangeFrequency(IEnumerable<byte?> bandSelection, IEnumerable<int> frequencySelection, byte lane)
    {
        if(_session == null)
        {
            return;
        }

        byte? bandId = bandSelection.FirstOrDefault();
        int frequencyInMhz = frequencySelection.FirstOrDefault();

        await OpenPracticeCommandHandler.TuneLane(_session.Id, lane, bandId, frequencyInMhz);

        _session.Lanes[lane].BandId = bandId;
        _session.Lanes[lane].FrequencyInMHz = frequencyInMhz;

        StateHasChanged();
    }

    private async Task TriggerDetection(Guid pilotId)
    {
        if(_session == null)
        {
            return;
        }
    }

    private async Task TriggerInvalidation(Guid pilotId)
    {
        if(_session == null)
        {
            return;
        }
    }
}
