@page "/open-practice/{id:guid}"
@using EventDbLite.Abstractions
@using NaeTime.Hardware.Abstractions
@using NaeTime.Hardware.Frequency

@if (_session != null)
{
    if (_session.IsActive)
    {
        <MudSwitch Color=Color.Primary T=bool @bind-Value=_isTuningEnabled></MudSwitch>
        <div class="lane-container">
            @foreach (Models.OpenPracticeLane lane in _session.Lanes)
            {
                <NaeTime.Client.BlazorWebApp.Components.OpenPractice.OpenPracticeLaneConfiguration Session=_session LaneId=lane.Lane AllPilots=_pilots MaxTime=_maximumLapTime MinTime=_minimumLapTime IsTuningEnabled=_isTuningEnabled></NaeTime.Client.BlazorWebApp.Components.OpenPractice.OpenPracticeLaneConfiguration>
            }
        </div>
    }

    <div class="d-flex flex-wrap justify-content-center">
        @foreach (Guid pilotId in _session.AttendingPilots)
        {
            <div class="shadow-sm p-3" style="width:400px;">
                <MudText Align="Align.Center" Typo="Typo.h5">@GetPilotName(pilotId)</MudText>
                <div class="w-100" style="max-height:50vh; overflow-y:scroll;">
                    <NaeTime.Client.BlazorWebApp.Components.OpenPractice.OpenPracticePilotTimingMoments SessionId=_session.Id TrackId=_session.TrackId PilotId=pilotId>
                    </NaeTime.Client.BlazorWebApp.Components.OpenPractice.OpenPracticePilotTimingMoments>
                </div>

            </div>
        }
    </div>
 }


@code {

    [Parameter]
    public Guid Id { get; set; }
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private IOpenPracticeQueryHandler OpenPracticeQueryHandler { get; set; } = null!;
    [Inject]
    private ITrackQueryHandler TrackQueryHandler { get; set; } = null!;
    [Inject]
    private IPilotQueryHandler PilotQueryHandler { get; set; } = null!;

    private Models.OpenPracticeSession? _session;
    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> _pilots = Enumerable.Empty<NaeTime.Query.Abstractions.Models.Pilot>();

    private TimeSpan _minimumLapTime = TimeSpan.Zero;
    private TimeSpan _maximumLapTime = TimeSpan.FromSeconds(30);

    private bool _isTuningEnabled = false;
    private bool _isActive = false;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    protected override async Task OnInitializedAsync()
    {
        _pilots = await PilotQueryHandler.GetAllPilots();

        _session = OpenPracticeSessionProjector.Project(await OpenPracticeQueryHandler.GetByIdAsync(Id));

        if (_session != null)
        {
            NaeTime.Query.Abstractions.Models.Track? track = await TrackQueryHandler.GetTrack(_session.TrackId);
            if(track != null)
            {
                _maximumLapTime = track.MaximumLapTimeMilliseconds.HasValue ? TimeSpan.FromMilliseconds(track.MaximumLapTimeMilliseconds.Value) : TimeSpan.MaxValue;
                _minimumLapTime = track.MinimumLapTimeMilliseconds.HasValue ? TimeSpan.FromMilliseconds(track.MinimumLapTimeMilliseconds.Value) : TimeSpan.Zero;
            }
        }
    }
    private string GetPilotName(Guid pilotId)
    {
        NaeTime.Query.Abstractions.Models.Pilot? pilot = _pilots.FirstOrDefault(x => x.Id == pilotId);
        if(pilot != null)
        {
            return pilot.Callsign ?? pilot.Firstname ?? pilot.Lastname ?? "[No Name]";
        }
        return "[Unknown Pilot]";
    }
}
