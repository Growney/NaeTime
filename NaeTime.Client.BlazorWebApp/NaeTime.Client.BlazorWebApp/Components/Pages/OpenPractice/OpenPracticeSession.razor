@page "/open-practice/{id:guid}"
@using EventDbLite.Abstractions
@using NaeTime.Hardware.Abstractions
@using NaeTime.Hardware.Frequency
@implements IAsyncDisposable

@if(_session != null)
{
    <div class="lane-container">
        @foreach (Models.OpenPracticeLane lane in _session.Lanes)
        {
            <div class="shadow rounded p-2" style="width: 200px">
                <table class="w-100 pb-2">
                    <tbody>
                        <tr>
                            <td class="align-start" style="width:10px">
                                <MudSwitch Color=Color.Primary T=bool Value="lane.IsEnabled" ValueChanged="x => EnabledChanged(x, lane.Lane)"></MudSwitch>
                            </td>
                            <td>
                                <div class="h4 text-start">
                                    @lane.Lane
                                </div>
                            </td>
                            <td>
                                <div class="h5 text-end">
                                    @lane.FrequencyInMHz<sup style="font-size:0.5em">MHz</sup>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="w-100 pb-2">
                    <MudMenu Class="w-100">
                        <ActivatorContent>
                            <MudButton Variant=Variant.Filled Size=Size.Small Color=Color.Info FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(_pilots.FirstOrDefault(x => x.Id == lane.PilotId)?.Callsign ?? "[None]")</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="x => OnPilotSelectionChanged(null, lane.Lane)">[Clear]</MudMenuItem>
                            @foreach (NaeTime.Query.Abstractions.Models.Pilot pilot in GetUnassignedPilots(lane.Lane))
                            {
                                <MudMenuItem OnClick="x => OnPilotSelectionChanged(pilot.Id, lane.Lane)">@pilot.Callsign</MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>                    
                </div>
                <div class="w-100 pb-2">
                    <MudMenu Class="w-100">
                        <ActivatorContent>
                            <MudButton Variant=Variant.Outlined Size=Size.Small Color=Color.Info FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(GetBandString(lane.BandId))</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Label="Custom" OnClick="() => ChangeFrequency(null, lane.FrequencyInMHz, lane)"></MudMenuItem>
                            @foreach (NaeTime.Hardware.Frequency.Band band in NaeTime.Hardware.Frequency.Band.Bands)
                            {
                                <MudMenuItem Label="@band.ShortName" OnClick="() => ChangeFrequency(band.Id, lane.FrequencyInMHz, lane)"></MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                </div>
                <div class="w-100" style="min-height:48px;">
                    @if (Band.Bands.Any(b => b.Id == lane.BandId))
                    {
                        <MudMenu Class="w-100">
                            <ActivatorContent>
                                <MudButton Variant=Variant.Outlined Size=Size.Medium Color=Color.Primary FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(GetFrequencyString(lane.BandId, lane.FrequencyInMHz))</MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                @{
                                    Band band = Band.Bands.FirstOrDefault(b => b.Id == lane.BandId);
                                    foreach (NaeTime.Hardware.Frequency.BandFrequency bandFrequency in band.Frequencies)
                                    {
                                        <MudMenuItem Label="@bandFrequency.Name" OnClick="() => ChangeFrequency(band.Id, bandFrequency.FrequencyInMhz, lane)"></MudMenuItem>
                                    }
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                    else
                    {
                        <MudNumericField T=int Value=lane.FrequencyInMHz Label="Custom" ValueChanged="x => ChangeFrequency(null, x, lane)"></MudNumericField>
                    }
                </div>
                
                <TimerDisplay Start="GetPilotLastDetectionTime(lane.PilotId)"></TimerDisplay>
                <div class="w-100 pb-2">
                    <MudButton Variant=Variant.Filled Color=Color.Success Class="w-100" onclick="() => TriggerDetection(lane.Lane)"><i class="fa-solid fa-stopwatch"></i></MudButton>                
                </div>
            </div>
        }
    </div>
    @if(_timingInfo != null)
    {
        <div class="d-flex flex-wrap justify-content-center">
            @foreach (var kvp in _timingInfo.SessionLapRecords)
            {
                <div class="shadow-sm p-3">
                    @if (kvp.Key == 1)
                    {
                        <h5 style="height: 1em;" class="w-100 text-center">Fastest Single Lap </h5>
                    }
                    else
                    {
                        <h5 style="height: 1em;" class="w-100 text-center">Fastest @kvp.Key Consecutive </h5>
                    }
                    <div style="width:300px;">
                        <table class="table table-striped">
                            <tr class="px-2">
                                <th>
                                    #
                                </th>
                                <th>
                                    Pilot
                                </th>
                                <th class="text-center">
                                    Time
                                </th>
                            </tr>
                            <tbody>
                                @foreach (var position in kvp.Value)
                                {
                                    <tr>
                                        <td>
                                        </td>
                                        <td>
                                            @GetPilotName(position.PilotId)
                                        </td>
                                        <td>
                                            @($"{position.Record:m\\:ss\\:fff}")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @foreach (var kvp in _timingInfo.PilotLaps)
            {
                <div class="shadow-sm p-3">
                    <h5 style="height: 1em;" class="w-100 text-center">@GetPilotName(kvp.Key) </h5>
                    <div style="width:300px;">
                        <table class="table table-striped">
                            <tr class="px-2">
                                <th>
                                    #
                                </th>
                                <th class="text-center">
                                    Time
                                </th>
                            </tr>
                            <tbody>
                                @foreach (var lap in kvp.Value)
                                {
                                    <tr>
                                        <td>
                                            @lap.StartDetection.UtcTime.ToString("HH:mm:ss")
                                        </td>
                                        <td>
                                            @lap.EndDetection.UtcTime.ToString("HH:mm:ss")
                                        </td>
                                        <td>
                                            @($"{lap.Duration:m\\:ss\\:fff}")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @foreach (var kvp in _timingInfo.PilotDetections)
            {
                <div class="shadow-sm p-3">
                    <h5 style="height: 1em;" class="w-100 text-center">@GetPilotName(kvp.Key) </h5>
                    <div style="width:300px;">
                        <table class="table table-striped">
                            <tr class="px-2">
                                <th>
                                    Lane
                                </th>
                                <th class="text-center">
                                    Software Time
                                </th>
                                <th class="text-center">
                                    Hardware Time
                                </th>
                                <th class="text-center">
                                    Date Time
                                </th>
                            </tr>
                            <tbody>
                                @foreach (var detection in kvp.Value)
                                {
                                    <tr>
                                        <td>
                                            @detection.Lane
                                        </td>
                                        <td>
                                            @detection.SoftwareTime
                                        </td>
                                        <td>
                                            @detection.HardwareTime
                                        </td>
                                        <td>
                                            @detection.UtcTime.ToString("HH:mm:ss.fff")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
}


@code {

    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private IReactionProvider ReactionProvider { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private IOpenPracticeCommandHandler OpenPracticeCommandHandler { get; set; } = null!;
    [Inject]
    private IOpenPracticeQueryHandler OpenPracticeQueryHandler { get; set; } = null!;
    [Inject]
    private ITrackQueryHandler TrackQueryHandler { get; set; } = null!;
    [Inject]
    private IPilotQueryHandler PilotQueryHandler { get; set; } = null!;
    [Inject]
    private ISoftwareTimer SoftwareTimer { get; set; } = null!;

    private Models.OpenPracticeSession? _session;
    private NaeTime.Query.Abstractions.Models.OpenPracticeSessionTimingInformation? _timingInfo;
    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> _pilots = Enumerable.Empty<NaeTime.Query.Abstractions.Models.Pilot>();

    private TimeSpan _minimumLapTime = TimeSpan.Zero;
    private TimeSpan _maximumLapTime = TimeSpan.FromSeconds(30);

    private DateTime? GetPilotLastDetectionTime(Guid? pilotId)
    {
        if(pilotId is null)
        {
            return null;
        }

        if(_timingInfo is null)
        {
            return null;
        }

        if(!_timingInfo.PilotDetections.ContainsKey(pilotId.Value))
        {
            return null;
        }
        return _timingInfo.PilotDetections[pilotId.Value].OrderByDescending(x => x.UtcTime).First().UtcTime;
    }

    protected override async Task OnInitializedAsync()
    {
        _pilots = await PilotQueryHandler.GetAllPilots();

        _session = OpenPracticeSessionProjector.Project(await OpenPracticeQueryHandler.GetByIdAsync(Id));

        if (_session != null)
        {
            NaeTime.Query.Abstractions.Models.Track? track = await TrackQueryHandler.GetTrack(_session.TrackId);
            if(track != null)
            {
                _maximumLapTime = track.MaximumLapTimeMilliseconds.HasValue ? TimeSpan.FromMilliseconds(track.MaximumLapTimeMilliseconds.Value) : TimeSpan.MaxValue;
                _minimumLapTime = track.MinimumLapTimeMilliseconds.HasValue ? TimeSpan.FromMilliseconds(track.MinimumLapTimeMilliseconds.Value) : TimeSpan.Zero;
            }
            _timingInfo = await OpenPracticeQueryHandler.GetTimingInformation(Id, _session.TrackId, _minimumLapTime, _maximumLapTime);
        }

        ReactionProvider.On<NaeTime.Events.OpenPracticePilotDetectionOccured>(async x =>
        {
            if (_session == null)
            {
                return;
            }

            _timingInfo = await OpenPracticeQueryHandler.GetTimingInformation(Id, _session.TrackId, _minimumLapTime, _maximumLapTime);

            StateHasChanged();
        });
        ReactionProvider.On<NaeTime.Events.OpenPracticePilotDetectionTriggered>(async x =>
        {

            if (_session == null)
            {
                return;
            }

            _timingInfo = await OpenPracticeQueryHandler.GetTimingInformation(Id, _session.TrackId, _minimumLapTime, _maximumLapTime);

            StateHasChanged();
        });
    }
    private string GetPilotName(Guid pilotId)
    {
        NaeTime.Query.Abstractions.Models.Pilot? pilot = _pilots.FirstOrDefault(x => x.Id == pilotId);
        if(pilot != null)
        {
            return pilot.Callsign ?? pilot.Firstname ?? pilot.Lastname ?? "[No Name]";
        }
        return "[Unknown Pilot]";
    }

    private async Task EnabledChanged(bool enabled, byte lane)
    {
        if(_session == null)
        {
            return;
        }

        if(enabled)
        {
            await OpenPracticeCommandHandler.EnableLane(_session.Id, lane);
        }
        else
        {
            await OpenPracticeCommandHandler.DisableLane(_session.Id, lane);
        }
        _session.Lanes[lane].IsEnabled = enabled;
    }

    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> GetUnassignedPilots(byte lane)
    {
        if(_session == null)
        {
            return Enumerable.Empty<NaeTime.Query.Abstractions.Models.Pilot>();
        }

        Guid? currentPilot = _session.Lanes[lane].PilotId;

        IEnumerable<Guid> usedPilots = _session.Lanes.Where(x => x.PilotId.HasValue).Select(x => x.PilotId!.Value);

        return _pilots.Where(x => !usedPilots.Contains(x.Id) || x.Id == currentPilot);
    }
    private async Task OnPilotSelectionChanged(Guid? pilotId, byte lane)
    {
        if(_session == null)
        {
            return;
        }

        if (pilotId.HasValue)
        {
            await OpenPracticeCommandHandler.SetLanePilot(_session.Id, lane, pilotId.Value);
        }
        else
        {
            await OpenPracticeCommandHandler.ResetLanePilot(_session.Id, lane);
        }

        _session.Lanes[lane].PilotId = pilotId;
    }
    private string GetBandString(byte? bandId)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            return band.ShortName;
        }

        return $"Custom";
    }
    private string GetFrequencyString(byte? bandId, int frequencyInMhz)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            if (band.Frequencies.Any(x => x.FrequencyInMhz == frequencyInMhz))
            {
                BandFrequency frequency = band.Frequencies.First(x => x.FrequencyInMhz == frequencyInMhz);
                return frequency.Name;
            }
        }

        return $"{frequencyInMhz} MHz";
    }
    private async Task ChangeFrequency(byte? bandId, int frequencyInMhz, Models.OpenPracticeLane lane)
    {
        if(_session == null)
        {
            return;
        }

        await OpenPracticeCommandHandler.TuneLane(_session.Id, lane.Lane, bandId, frequencyInMhz);

        lane.BandId = bandId;
        lane.FrequencyInMHz = frequencyInMhz;

        StateHasChanged();
    }

    public ValueTask DisposeAsync() => ReactionProvider.DisposeAsync();

    private async Task TriggerDetection(byte lane)
    {
        if(_session == null)
        {
            return;
        }

        await OpenPracticeCommandHandler.TriggerDetection(Guid.NewGuid(), Id, lane, 0, null, SoftwareTimer.ElapsedMilliseconds, DateTime.UtcNow);  
    }
}
