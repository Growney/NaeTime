@page "/track/list"


<a class="btn btn-primary" href="/track/create">Create Track</a>
<MudSimpleTable>
    <thead>
        <tr>
            <th>Name</th>
            <th>Detectors</th>
            <th>Lanes</th>
            <th>Minimum Lap Time</th>
            <th>Maximum Lap Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach(NaeTime.Query.Abstractions.Models.Track track in _tracks)
        {
            <tr @onclick="() => EditTrack(track.Id)">
                <td>@track.Name</td>
                <td><span class="badge badge-info">x @track.Detectors.Count()</span></td>
                <td><span class="badge badge-info">x @track.MaxLanes</span></td>
                @if(track.MinimumLapTimeMilliseconds.HasValue == false)
                {
                    <td>N/A</td>
                }
                else
                {
                    <td>@(TimeSpan.FromMilliseconds(track.MinimumLapTimeMilliseconds.Value))</td>
                }
                @if(track.MaximumLapTimeMilliseconds.HasValue == false)
                {
                    <td>N/A</td>
                }
                else
                {
                    <td>@(TimeSpan.FromMilliseconds(track.MaximumLapTimeMilliseconds.Value))</td>
                }
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code{
    [Inject]
    private ITrackQueryHandler TrackQueryHandler { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private IHardwareQueryHandler HardwareQueryHandler { get; set; } = null!;
    private IEnumerable<NaeTime.Query.Abstractions.Models.Track> _tracks = Enumerable.Empty<NaeTime.Query.Abstractions.Models.Track>();

    protected override async Task OnInitializedAsync()
    {
        _tracks = await TrackQueryHandler.GetAllTracks();
    }

    private void EditTrack(Guid id)
    {
        NavigationManager.NavigateTo($"/track/{id}");
    }
}