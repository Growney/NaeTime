@implements IDisposable
@rendermode InteractiveAuto
<div class="w-100">
    @if (Start == null)
    {
        <div>
            --:--
        </div>
    }
    else
    {
        var timeSinceStart = DateTime.UtcNow - Start.Value;

        string colour = MaxTime.HasValue && timeSinceStart > MaxTime ? "text-danger" : "";
        colour = MinTime.HasValue && timeSinceStart < MinTime ? "text-warning" : colour;

        <div class="@colour" style="font-variant-numeric: tabular-nums">
            @timeSinceStart.ToString("mm\\:ss\\:")<span style="font-size:0.75em;">@timeSinceStart.Milliseconds.ToString("000")</span>
        </div>
    }
</div>

@code {

    [Parameter]
    public DateTime? Start { get; set; }
    [Parameter]
    public TimeSpan? MaxTime { get; set; }
    [Parameter]
    public TimeSpan? MinTime { get; set; }

    private Timer? _timer;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _timer = new Timer(x =>
                       this.InvokeAsync(StateHasChanged), null, 0, 10);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}