@using EventDbLite.Abstractions
@using EventDbLite.Reactions.Abstractions
@implements IDisposable
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudNumericField T="long?" @bind-Value="_pilotMinimumLapTimeMs"
                     Label="Min (ms)"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Style="max-width:110px"
                     @onblur="SavePilotMinimumLapTime" />
    <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Title="Reset pilot minimum" OnClick="ResetPilotMinimumLapTime" />
    <MudNumericField T="long?" @bind-Value="_pilotMaximumLapTimeMs"
                     Label="Max (ms)"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Style="max-width:110px"
                     @onblur="SavePilotMaximumLapTime" />
    <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Title="Reset pilot maximum" OnClick="ResetPilotMaximumLapTime" />
</MudStack>
@if (_timingInfo != null)
{
    @if (_fastestLap != null)
    {
        <div class="d-flex justify-content-center">
            <MudButton Variant=Variant.Outlined EndIcon=@Icons.Material.Filled.Close Color="Color.Error" OnClick="() => InvalidateDetection(_fastestLap.IncludedLaps.First().StartDetection.Id)">@_fastestLap.Record.ToString("m\\:ss\\:fff")</MudButton>
        </div>
    }
    <MudTimeline TimelineOrientation=TimelineOrientation.Vertical TimelinePosition="TimelinePosition.Left">
        @foreach (Query.Abstractions.Models.TimingMoment moment in _timingInfo.Moments.Reverse())
        {
            <MudTimelineItem Color="GetMomentColor(moment)" Class="hidden-hover-parent">
                <ItemContent>
                    <MudText Typo="Typo.body2">
                        <MudGrid Justify=Justify.SpaceBetween>
                            <MudItem>
                                <MudText Typo=Typo.body1>
                                    @GetMomentSecondaryText(moment)
                                </MudText>
                            </MudItem>
                            <MudItem>
                                <div class="hidden-until-hover">
                                    @if (moment.MomentId.HasValue
                                                                && moment.Type != Query.Abstractions.Models.TimingMoment.TimingMomentType.EndOfPack
                                                                && moment.Type != Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStoppedByEndOfPack)
                                    {

                                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="() => InsertPackEndBeforeDetection(moment.MomentId.Value)"></MudIconButton>
                                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="() => InsertPackEndAfterDetection(moment.MomentId.Value)"></MudIconButton>
                                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Upload" Size="Size.Small" OnClick="() => InvalidateBeforeDetection(moment.MomentId.Value)"></MudIconButton>
                                    }
                                    else if (moment.MomentId.HasValue)
                                    {
                                        <MudIconButton Color="Color.Success" Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => RemoveLapEnd(moment.MomentId.Value)"></MudIconButton>
                                    }

                                    @if (moment.MomentId.HasValue && moment.Type == Query.Abstractions.Models.TimingMoment.TimingMomentType.LapCompleted)
                                    {
                                        <MudIconButton Color="Color.Warning" Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => InvalidateDetection(moment.MomentId.Value)"></MudIconButton>
                                    }
                                    else if (moment.MomentId.HasValue && moment.Type == Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedAsItsInvalid)
                                    {
                                        <MudIconButton Color="Color.Success" Icon="@Icons.Material.Filled.Check" Size="Size.Small" OnClick="() => ValidateDetection(moment.MomentId.Value)"></MudIconButton>
                                    }
                                </div>
                            </MudItem>
                        </MudGrid>

                    </MudText>
                </ItemContent>
                <ItemOpposite>

                </ItemOpposite>
            </MudTimelineItem>
        }
    </MudTimeline>
}

@code {
    [Parameter]
    [EditorRequired]
    public Guid SessionId { get; set; }
    [Parameter]
    [EditorRequired]
    public Guid TrackId { get; set; }
    [Parameter]
    [EditorRequired]
    public Guid PilotId { get; set; }

    [Inject]
    private IOpenPracticeCommandHandler OpenPracticeCommandHandler { get; set; } = null!;

    [Inject]
    private IDetectionCommandHandler DetectionCommandHandler { get; set; } = null!;
    [Inject]
    private ITimingQueryHandler OpenPracticeQueryHandler { get; set; } = null!;
    [Inject]
    private ITrackQueryHandler TrackQueryHandler { get; set; } = null!;
    [Inject]
    private IReactionProviderFactory ReactionProviderFactory { get; set; } = null!;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    private Query.Abstractions.Models.SessionPilotTimingInfo? _timingInfo;
    private Query.Abstractions.Models.OpenPracticeLapRecord? _fastestLap => _timingInfo?.LapRecords.FirstOrDefault(x => x.Key == 1).Value;

    private long? _pilotMinimumLapTimeMs;
    private long? _pilotMaximumLapTimeMs;
    protected override async Task OnParametersSetAsync()
    {
        await Refresh();
        var (min, max) = await OpenPracticeQueryHandler.GetPilotLapTimeOverrides(SessionId, PilotId);
        _pilotMinimumLapTimeMs = min.HasValue ? (long?)min.Value.TotalMilliseconds : null;
        _pilotMaximumLapTimeMs = max.HasValue ? (long?)max.Value.TotalMilliseconds : null;
        await base.OnParametersSetAsync();
    }

    protected override Task OnInitializedAsync()
    {
        ReactionProviderFactory.On<Events.OpenPracticePilotTimingChangeOccured>(async x =>
        {
            if (x.SessionId == SessionId && x.PilotId == PilotId)
            {
                await Refresh();
            }
        }, _cancellationTokenSource.Token);

        return base.OnInitializedAsync();
    }
    private TimeSpan GetLapTime(Guid? momentId)
    {
        Query.Abstractions.Models.OpenPracticeLap? lap = _timingInfo?.LapGroups.SelectMany(x => x).FirstOrDefault(x => x.EndDetection.Id == momentId);
        if (lap != null)
        {
            return lap.Duration;
        }
        return TimeSpan.Zero;
    }
    private string GetMomentPrimaryText(Query.Abstractions.Models.TimingMoment moment)
    {
        return moment.Type switch
        {
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapCompleted => $"Completed",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStarted => $"Started",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedAsItsInvalid
                or Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedDueToMinimiumLapTime => $"Detection Discarded",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapInvalidatedDueToMaximumLapTime => $"Invalidated",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStoppedByEndOfPack => $"Stopped",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.EndOfPack => $"End of Pack",
            _ => string.Empty
        };
    }
    private string GetMomentSecondaryText(Query.Abstractions.Models.TimingMoment moment)
    {
        return moment.Type switch
        {
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapCompleted => $"{GetLapTime(moment.MomentId):m\\:ss\\:fff}",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedAsItsInvalid => $"Invalid",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedDueToMinimiumLapTime => $"Too Short",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapInvalidatedDueToMaximumLapTime => $"Too Long",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStoppedByEndOfPack => $"End of Pack",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.EndOfPack => $"End of Pack",
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStarted => $"Started",
            _ => string.Empty
        };
    }
    private Color GetMomentColor(Query.Abstractions.Models.TimingMoment moment)
    {
        return moment.Type switch
        {
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapCompleted => Color.Success,
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStarted => Color.Info,
            Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedAsItsInvalid
                or Query.Abstractions.Models.TimingMoment.TimingMomentType.DetectionDiscardedDueToMinimiumLapTime => Color.Warning,
            Query.Abstractions.Models.TimingMoment.TimingMomentType.LapInvalidatedDueToMaximumLapTime
                or Query.Abstractions.Models.TimingMoment.TimingMomentType.LapStoppedByEndOfPack
                or Query.Abstractions.Models.TimingMoment.TimingMomentType.EndOfPack => Color.Error,
            _ => Color.Default
        };
    }
    private async Task Refresh()
    {
        Console.WriteLine("Refreshing timing moments {PilotId}");

        _timingInfo = await OpenPracticeQueryHandler.GetTimingInformation(SessionId, TrackId, PilotId);
        StateHasChanged();
    }

    private async Task InvalidateDetection(Guid detectionId)
    {
        await DetectionCommandHandler.SetStatus(detectionId, false);
    }
    private async Task InvalidateBeforeDetection(Guid detectionId)
    {
        await OpenPracticeCommandHandler.InvalidatePilotDetectionsBeforeDetection(SessionId, detectionId);
    }

    private async Task SavePilotMinimumLapTime()
    {
        if (_pilotMinimumLapTimeMs.HasValue && _pilotMinimumLapTimeMs.Value > 0)
        {
            await OpenPracticeCommandHandler.SetPilotMinimumLapTime(SessionId, PilotId, TimeSpan.FromMilliseconds(_pilotMinimumLapTimeMs.Value));
        }
    }

    private async Task ResetPilotMinimumLapTime()
    {
        await OpenPracticeCommandHandler.ResetPilotMinimumLapTime(SessionId, PilotId);
        _pilotMinimumLapTimeMs = null;
        await Refresh();
        StateHasChanged();
    }

    private async Task SavePilotMaximumLapTime()
    {
        if (_pilotMaximumLapTimeMs.HasValue && _pilotMaximumLapTimeMs.Value > 0)
        {
            await OpenPracticeCommandHandler.SetPilotMaximumLapTime(SessionId, PilotId, TimeSpan.FromMilliseconds(_pilotMaximumLapTimeMs.Value));
            await Refresh();
            StateHasChanged();
        }
    }

    private async Task ResetPilotMaximumLapTime()
    {
        await OpenPracticeCommandHandler.ResetPilotMaximumLapTime(SessionId, PilotId);
        _pilotMaximumLapTimeMs = null;
        await Refresh();
        StateHasChanged();
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
    }

    private async Task ValidateDetection(Guid detectionid)
    {
        await DetectionCommandHandler.SetStatus(detectionid, true);
    }

    private async Task RemoveLapEnd(Guid lapStopId)
    {
        await OpenPracticeCommandHandler.RemovePilotPackEnd(SessionId, lapStopId);
    }

    private async Task InsertPackEndAfterDetection(Guid detection)
    {
        await OpenPracticeCommandHandler.InsertPilotPackEndAfterDetection(SessionId, detection);
    }

    private async Task InsertPackEndBeforeDetection(Guid detection)
    {
        await OpenPracticeCommandHandler.InsertPilotPackEndBeforeDetection(SessionId, detection);
    }
}
