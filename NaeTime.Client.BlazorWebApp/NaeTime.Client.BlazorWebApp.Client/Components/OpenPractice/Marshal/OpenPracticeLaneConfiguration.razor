@using EventDbLite.Abstractions
@using EventDbLite.Reactions.Abstractions
@using NaeTime.Hardware.Abstractions
@using NaeTime.Hardware.Frequency
@implements IDisposable

<table class="w-100 pb-2">
    <tbody>
        <tr>
            <td class="align-start" style="width:10px">
                <MudSwitch Color=Color.Primary T=bool Value="_lane.IsEnabled" ValueChanged="x => EnabledChanged(x)"></MudSwitch>
            </td>
            <td>
                <div class="h4 text-start">
                    @_lane.Lane
                </div>
            </td>
            <td>
                <div class="h5 text-end">
                    @_lane.FrequencyInMHz<sup style="font-size:0.5em">MHz</sup>
                </div>
            </td>
        </tr>
    </tbody>
</table>


<div class="w-100 pb-2">
    <MudMenu Class="w-100">
        <ActivatorContent>
            <MudButton Variant=Variant.Filled Size=Size.Small Color=Color.Info FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(AllPilots.FirstOrDefault(x => x.Id == _lane.PilotId)?.Callsign ?? "[None]")</MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem OnClick="x => OnPilotSelectionChanged(null)">[Clear]</MudMenuItem>
            @foreach (NaeTime.Query.Abstractions.Models.Pilot pilot in GetUnassignedPilots())
            {
                <MudMenuItem OnClick="x => OnPilotSelectionChanged(pilot.Id)">@pilot.Callsign</MudMenuItem>
            }
        </ChildContent>
    </MudMenu>                    
</div>
<MudGrid Spacing=1 xs=12 Justify=Justify.Center>
    <MudItem xxl=6 xl=12 lg=12 md=12 sm=12 xs=12>
        <MudMenu Class="w-100">
            <ActivatorContent>
                <MudButton Variant=Variant.Outlined Size=Size.Small Color=Color.Info FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(GetBandString(_lane.BandId))</MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Label="Custom" OnClick="() => ChangeFrequency(null, _lane.FrequencyInMHz)"></MudMenuItem>
                @foreach (NaeTime.Hardware.Frequency.Band band in NaeTime.Hardware.Frequency.Band.Bands)
                {
                    <MudMenuItem Label="@band.ShortName" OnClick="() => ChangeFrequency(band.Id, _lane.FrequencyInMHz)"></MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </MudItem>
    <MudItem xxl=6 xl=12 lg=12 md=12 sm=12 xs=12>
        @if (Band.Bands.Any(b => b.Id == _lane.BandId))
        {
            <MudMenu Class="w-100">
                <ActivatorContent>
                    <MudButton Variant=Variant.Outlined Size=Size.Small Color=Color.Primary FullWidth=true EndIcon="@Icons.Material.Filled.KeyboardArrowDown">@(GetFrequencyString(_lane.BandId, _lane.FrequencyInMHz))</MudButton>
                </ActivatorContent>
                <ChildContent>
                    @{
                        Band band = Band.Bands.FirstOrDefault(b => b.Id == _lane.BandId);
                        foreach (NaeTime.Hardware.Frequency.BandFrequency bandFrequency in band.Frequencies)
                        {
                            <MudMenuItem Label="@bandFrequency.Name" OnClick="() => ChangeFrequency(band.Id, bandFrequency.FrequencyInMhz)"></MudMenuItem>
                        }
                    }
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudNumericField T=int Value=_lane.FrequencyInMHz Label="Custom" ValueChanged="x => ChangeFrequency(null, x)"></MudNumericField>
        }
    </MudItem>
</MudGrid>
<div class="w-100 pb-2 pt-2 d-flex justify-content-center">
    @foreach (Guid detectorId in Session.TrackDetectorIds)
    {
        <NaeTime.Client.BlazorWebApp.Client.Components.Hardware.TimerStatus TimerId=detectorId LaneId=LaneId OnClicked="ToggleTuningTimer"></NaeTime.Client.BlazorWebApp.Client.Components.Hardware.TimerStatus>
    }
</div>
<div class="text-center" style="font-size: 2.5em; min-height:1.5em;">
    <OpenPracticePilotLastDetectionTimer SessionId="Session.Id" TrackId="Session.TrackId" PilotId="_lane.PilotId" MaxTime=Session.MaximumLapTime MinTime=Session.MinimumLapTime></OpenPracticePilotLastDetectionTimer>
</div>
@foreach (Guid detectorId in _tuningTimers)
{
    <NaeTime.Client.BlazorWebApp.Client.Components.Hardware.TimerLaneTuner TimerId=detectorId LaneId=LaneId></NaeTime.Client.BlazorWebApp.Client.Components.Hardware.TimerLaneTuner>
}
<div class="w-100 pb-2">
    <MudIconButton Icon=@Icons.Material.Filled.Timer Variant=Variant.Filled Color=Color.Success Class="w-100" onclick="() => TriggerDetection()"></MudIconButton>                
</div>

@code {
    [Parameter]
    [EditorRequired]
    public NaeTime.Client.Models.OpenPracticeSession Session{ get; set; }
    [Parameter]
    [EditorRequired]
    public byte LaneId { get; set; }
    [Parameter]
    [EditorRequired]
    public IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> AllPilots { get; set; }

    [Parameter]
    public bool IsTuningEnabled { get; set; } = false;

    private NaeTime.Client.Models.OpenPracticeLane _lane => Session.Lanes[LaneId];

    [Inject]
    private IOpenPracticeCommandHandler OpenPracticeCommandHandler { get; set; } = null!;
    [Inject]
    private IOpenPracticeQueryHandler OpenPracticeQueryHandler { get; set; } = null!;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    private HashSet<Guid> _tuningTimers = new();

    private void ToggleTuningTimer(Guid timerId)
    {
        if (_tuningTimers.Contains(timerId))
        {
            _tuningTimers.Remove(timerId);
        }
        else
        {
            _tuningTimers.Add(timerId);
        }
    }

    private async Task TriggerDetection()
    {
        await OpenPracticeCommandHandler.TriggerDetection(Guid.NewGuid(), Session.Id, LaneId, 0);
    }

    private string GetPilotName(Guid pilotId)
    {
        NaeTime.Query.Abstractions.Models.Pilot? pilot = AllPilots.FirstOrDefault(x => x.Id == pilotId);
        if (pilot != null)
        {
            return pilot.Callsign ?? pilot.Firstname ?? pilot.Lastname ?? "[No Name]";
        }
        return "[Unknown Pilot]";
    }

    private async Task EnabledChanged(bool enabled)
    {
        if (enabled)
        {
            await OpenPracticeCommandHandler.EnableLane(Session.Id, LaneId);
        }
        else
        {
            await OpenPracticeCommandHandler.DisableLane(Session.Id, LaneId);
        }
        _lane.IsEnabled = enabled;
    }

    private IEnumerable<NaeTime.Query.Abstractions.Models.Pilot> GetUnassignedPilots()
    {
        Guid? currentPilot = _lane.PilotId;

        IEnumerable<Guid> usedPilots = Session.Lanes.Where(x => x.PilotId.HasValue).Select(x => x.PilotId!.Value);

        return AllPilots.Where(x => !usedPilots.Contains(x.Id) || x.Id == currentPilot);
    }
    private async Task OnPilotSelectionChanged(Guid? pilotId)
    {
        Console.WriteLine($"New PilotId: {pilotId}");
        Console.WriteLine($"Setting lane: {pilotId}");
        _lane.PilotId = pilotId;
        if (pilotId.HasValue)
        {
            await OpenPracticeCommandHandler.SetLanePilot(Session.Id, LaneId, pilotId.Value);
        }
        else
        {
            await OpenPracticeCommandHandler.ResetLanePilot(Session.Id, LaneId);
        }
    }
    private string GetBandString(byte? bandId)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            return band.ShortName;
        }

        return $"Custom";
    }
    private string GetFrequencyString(byte? bandId, int frequencyInMhz)
    {
        if (Band.Bands.Any(x => x.Id == bandId))
        {
            Band band = Band.Bands.First(x => x.Id == bandId);

            if (band.Frequencies.Any(x => x.FrequencyInMhz == frequencyInMhz))
            {
                BandFrequency frequency = band.Frequencies.First(x => x.FrequencyInMhz == frequencyInMhz);
                return frequency.Name;
            }
        }

        return $"{frequencyInMhz} MHz";
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private async Task ChangeFrequency(byte? bandId, int frequencyInMhz)
    {
        if (Session == null)
        {
            return;
        }

        await OpenPracticeCommandHandler.TuneLane(Session.Id, LaneId, bandId, frequencyInMhz);

        _lane.BandId = bandId;
        _lane.FrequencyInMHz = frequencyInMhz;
    }
}
