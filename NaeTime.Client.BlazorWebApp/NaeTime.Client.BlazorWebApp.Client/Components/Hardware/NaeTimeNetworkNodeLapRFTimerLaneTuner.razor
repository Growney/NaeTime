@using NaeTime.Client.BlazorWebApp.Client.Services
@using NaeTime.Query.Abstractions.Models

<NaeTime.Client.BlazorWebApp.Client.Components.Hardware.RssiChart @ref=_rssiChart TimerId=TimerId LaneId=LaneId></NaeTime.Client.BlazorWebApp.Client.Components.Hardware.RssiChart>

@if (_lane != null)
{
    <MudNumericField Label="Entry Threshold" T="ushort" Value="_lane.EntryThreshold.Requested ?? _lane.EntryThreshold.Confirmed ?? 800" ValueChanged="EntryThresholdChanged"></MudNumericField>
    <MudNumericField Label="Exit Threshold" T="ushort" Value="_lane.ExitThreshold.Requested ?? _lane.ExitThreshold.Confirmed ?? 59" ValueChanged="ExitThresholdChanged"></MudNumericField>
}

@code {
    [Parameter]
    public Guid TimerId { get; set; }
    [Parameter]
    public byte LaneId { get; set; }

    [Inject]
    private NaeTime.Command.Abstractions.INaeTimeNodeCommandHandler NaeTimeNodeCommandHandler { get; set; } = null!;
    [Inject]
    private NaeTime.Query.Abstractions.IHardwareQueryHandler HardwareQueryHandler { get; set; } = null!;
    [Inject]
    private RssiService RssiService { get; set; } = null!;

    private NaeTime.Query.Abstractions.Models.NaeTimeNodeLane? _lane;
    private RssiChart? _rssiChart;


    protected override async Task OnInitializedAsync()
    {
        NaeTime.Query.Abstractions.Models.NaeTimeNodeLane? laneConfiguration = await HardwareQueryHandler.GetNaeTimeNodeLane(TimerId, LaneId);

        RssiService.OnRssiReceived += OnRssiReceived;

        _lane = laneConfiguration;

        await base.OnInitializedAsync();
    }
    private async void OnRssiReceived(RssiValue rssi)
    {
        try
        {

            if (_rssiChart is null)
            {
                return;
            }
            if (rssi.TimerId != TimerId || rssi.Lane != LaneId)
            {
                return;
            }

            await _rssiChart.AddLineValue("rssi", DateTime.Now, rssi.Rssi);
        }
        catch
        {
            // Ignore JS errors
        }
    }
    private async Task EntryThresholdChanged(ushort newThreshold)
    {
        if (_lane is null)
        {
            return;
        }

        await NaeTimeNodeCommandHandler.RequestLaneEntryThreshold(TimerId, LaneId, newThreshold);
        _lane = _lane with { EntryThreshold = _lane.EntryThreshold with { Requested = newThreshold } };
    }

    private async Task ExitThresholdChanged(ushort newThreshold)
    {
        if (_lane is null)
        {
            return;
        }
        await NaeTimeNodeCommandHandler.RequestLaneExitThreshold(TimerId, LaneId, newThreshold);
        _lane = _lane with { ExitThreshold = _lane.ExitThreshold with { Requested = newThreshold } };
    }
}
