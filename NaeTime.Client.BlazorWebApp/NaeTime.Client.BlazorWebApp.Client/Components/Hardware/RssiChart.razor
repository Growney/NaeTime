@using EventDbLite.Reactions.Abstractions
@using NaeTime.Client.BlazorWebApp.Client.Services
@using NaeTime.Query.Abstractions.Models
@implements IAsyncDisposable

<canvas id="@_chartId" style="width:100%; height: 200px"></canvas>

@code {

    public record HorizontalLine(string Key, int InitialValue, float Thickness, string Colour);
    public record Series(string Key);

    [Parameter]
    [EditorRequired]
    public string ChartType { get; set; }
    [Parameter]
    public IEnumerable<Series> ChartSeries { get; set; } = Array.Empty<Series>();
    [Parameter]
    public IEnumerable<RssiChart.HorizontalLine> HorizontalLines { get; set; } = Array.Empty<RssiChart.HorizontalLine>();
    [Parameter]
    public int MaxValue { get; set; } = int.MaxValue;
    [Parameter]
    public int MinValue { get; set; } = 0;

    private IJSObjectReference? _chart;

    private readonly Dictionary<string, IJSObjectReference> _horizontalLines = new();
    private readonly Dictionary<string, IJSObjectReference> _series = new();

    [Inject]
    private RssiService RssiService { get; set; } = null!;
    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;

    private int _chartId;

    protected override void OnInitialized()
    {
        _chartId = GetHashCode();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(_chart == null)
        {
            _chart = await JSRuntime.InvokeAsync<IJSObjectReference>("createRssiSmootheChart", ChartType, _chartId, MinValue, MaxValue);
        }

        foreach(Series series in ChartSeries)
        {
            if(_series.ContainsKey(series.Key))
            {
                continue;
            }
            var jsSeries = await JSRuntime.InvokeAsync<IJSObjectReference>("addRssiLine", _chart);
            _series[series.Key] = jsSeries;
        }

        foreach (HorizontalLine line in HorizontalLines)
        {
            if (_horizontalLines.ContainsKey(line.Key))
            {
                continue;
            }
            var jsLine = await JSRuntime.InvokeAsync<IJSObjectReference>("addHorizontalLine", _chart, line.InitialValue,line.Colour,line.Thickness);
            _horizontalLines[line.Key] = jsLine;
        }
        

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task AddSeriesValue(string lineKey, DateTime when, float value)
    {
        if (!_series.TryGetValue(lineKey, out var line))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("addValueToLine", line, when, value);
    }
    public async Task UpdateHorizontalLineValue(string lineKey, int newValue)
    {
        if (!_horizontalLines.TryGetValue(lineKey, out var line))
        {
            return;
        }
        await JSRuntime.InvokeVoidAsync("setLineValue", line, newValue);
    }

    public async ValueTask DisposeAsync()
    {
        foreach(var _horizontalLine in _horizontalLines.Values)
        {
            await _horizontalLine.DisposeAsync();
        }
        foreach(var _rssiSeries in _series.Values)
        {
            await _rssiSeries.DisposeAsync();
        }

        if (_chart != null)
        {
            await _chart.DisposeAsync();
        }
    }
}
