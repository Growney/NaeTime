@using EventDbLite.Reactions.Abstractions
@using NaeTime.Client.BlazorWebApp.Client.Services
@using NaeTime.Query.Abstractions.Models
@implements IAsyncDisposable

<canvas id="@_chartId" style="width:100%; height: 200px"></canvas>

@code {
    [Parameter]
    public Guid TimerId { get; set; }
    [Parameter]
    public byte LaneId { get; set; }

    private IJSObjectReference? _chart;
    private IJSObjectReference? _rssiSeries;

    private readonly CancellationTokenSource _source = new();

    [Inject]
    private RssiService RssiService { get; set; } = null!;
    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;

    private int _chartId;

    protected override async Task OnInitializedAsync()
    {
        _chartId = GetHashCode();

        RssiService.OnRssiReceived += OnRssiReceived;

        await RssiService.StartAsync();
    }

    private void OnRssiReceived(RssiValue rssi)
    {
        if (_rssiSeries is null || _chart is null)
        {
            return;
        }
        if (rssi.TimerId != TimerId || rssi.Lane != LaneId)
        {
            return;
        }
        if (_rssiSeries is not null)
        {
            InvokeAsync(() => JSRuntime.InvokeVoidAsync("addValueToLine", _rssiSeries, DateTime.Now, rssi.Rssi));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chart = await JSRuntime.InvokeAsync<IJSObjectReference>("createRssiSmootheChart", "rssi", _chartId, 0, 3800);
            _rssiSeries = await JSRuntime.InvokeAsync<IJSObjectReference>("addRssiLine", _chart);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        _source.Cancel();
        _source.Dispose();

        if(_rssiSeries is not null)
        {
            await _rssiSeries.DisposeAsync();
        }
        if (_chart is not null)
        {
            await _chart.DisposeAsync();
        }

        RssiService.OnRssiReceived -= OnRssiReceived;
    }
}
