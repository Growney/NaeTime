@using NaeTime.Hardware.Frequency

<div class="overlay-container h-100 w-100 text-white text-center">
    <div class="overlay-header bg-primary">
        <div>@PilotName</div>
    </div>
    <div class="overlay-header-details bg-primary">
        @{
            BandFrequency? bandFrequency = BandFrequency;

            if (bandFrequency.HasValue)
            {
                <div>@bandFrequency.Value.Name</div>
            }
            else
            {
                <div>@Details.FrequencyInMHz<span class="h3">MHz</span></div>
            }
        }
    </div>
    @if (_pilotTimingInfo != null)
    {
        <div class="overlay-footer-details bg-primary d-flex align-items-center">
            <NaeTime.Client.BlazorWebApp.Client.Components.OpenPractice.TimerDisplay MinTime="MinTime" MaxTime="MaxTime" Start="_lastDetection"></NaeTime.Client.BlazorWebApp.Client.Components.OpenPractice.TimerDisplay>
        </div>
        <div class="overlay-footer bg-primary d-flex justify-content-evenly text-white">
            @foreach (var lapRecord in GetIncludedLapRecords())
            {
                <div>
                    @if (lapRecord.LapCount == 1)
                    {
                        <span>Fastest Single:</span>
                    }
                    else
                    {
                        <span>@lapRecord.LapCount Consecutive:</span>
                    }
                    <span>@lapRecord.Record.ToString(@"mm\:ss\.fff")</span>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter]
    [EditorRequired]
    public Guid SessionId { get; set; }
    [Parameter]
    [EditorRequired]
    public Guid TrackId { get; set; }
    [Parameter]
    [EditorRequired]
    public NaeTime.Query.Abstractions.Models.OpenPracticeLane Details { get; set; } = null!;
    [Parameter]
    [EditorRequired]
    public TimeSpan? MaxTime { get; set; }
    [Parameter]
    [EditorRequired]
    public TimeSpan? MinTime { get; set; }

    [Parameter]
    public IEnumerable<int> IncludedLapRecords { get; set; } = Enumerable.Empty<int>();

    [Inject]
    public IPilotQueryHandler PilotQueryHandler { get; set; } = null!;
    [Inject]
    public ITimingQueryHandler OpenPracticeQueryHandler { get; set; } = null!;

    private BandFrequency? BandFrequency 
    { 
        get
        {
            NaeTime.Hardware.Frequency.Band? band = NaeTime.Hardware.Frequency.Band.Bands.FirstOrDefault(x => x.Id == Details.BandId);

            if (!band.HasValue)
            {
                return null;
            }

            return band.Value.Frequencies.FirstOrDefault(x => x.FrequencyInMhz == Details.FrequencyInMHz);
        }
    }

    private string? PilotName
    {
        get
        {
            if(_pilot == null)
            {
                return string.Empty;
            }

            return _pilot.Callsign ?? _pilot.Firstname + " " + _pilot.Lastname;
        }
    }
    private NaeTime.Query.Abstractions.Models.Pilot? _pilot;
    private NaeTime.Query.Abstractions.Models.SessionPilotTimingInfo? _pilotTimingInfo;
    private DateTime? _lastDetection;

    private IEnumerable<NaeTime.Query.Abstractions.Models.OpenPracticeLapRecord> GetIncludedLapRecords()
    {
        if (_pilotTimingInfo == null)
        {
            yield break;
        }

        if (!_pilotTimingInfo.LapRecords.Any())
        {
            yield break;
        }

        IEnumerable<NaeTime.Query.Abstractions.Models.OpenPracticeLapRecord> sortedRecords = _pilotTimingInfo.LapRecords.OrderBy(x => x.Key).Select(x => x.Value);

        foreach(var record in sortedRecords)
        {
            if (IncludedLapRecords.Contains((int)record.LapCount))
            {
                yield return record;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Details.PilotId.HasValue)
        {
            _pilot = await PilotQueryHandler.GetPilotById(Details.PilotId.Value);

            _pilotTimingInfo = await OpenPracticeQueryHandler.GetTimingInformation(SessionId, TrackId, Details.PilotId.Value);

            _lastDetection = _pilotTimingInfo?.Detections.OrderByDescending(x => x.UtcTime).FirstOrDefault()?.UtcTime;
        }
    }
}
