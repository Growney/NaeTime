@page "/pilot/create"

@if (_pilot != null)
{
    <MudGrid Justify=Justify.Center>
        <MudItem xs=3>
            <MudIconButton Icon=@Icons.Material.Filled.ArrowLeft Href="/pilot/list"></MudIconButton>
            <MudPaper Class="p-4">
                <MudForm @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_pilot.Firstname" Label="Firstname" Required="true"></MudTextField>
                    <MudTextField @bind-Value="_pilot.Lastname" Label="Lastname" Required="true"></MudTextField>
                    <MudTextField @bind-Value="_pilot.Callsign" Label="Callsign" Required="true"></MudTextField>
                    <MudTextField @bind-Value="_pilot.BindingPhrase" Label="Binding Phrase"></MudTextField>
                    <MudButton Disabled=@(!_isValid) Variant="Variant.Filled" Color="Color.Primary" OnClick="Create">Create</MudButton>
                    <MudButton Disabled=@(!_isValid) Variant="Variant.Filled" Color="Color.Secondary" OnClick="CreateAndContinue">Create &amp; Continue</MudButton>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {

    [Inject]
    private IPilotCommandHandler PilotCommandHandler { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private NaeTime.Client.Models.Pilot? _pilot;

    private bool _isValid = false;

    protected override void OnInitialized()
    {
        _pilot = new NaeTime.Client.Models.Pilot()
        {
            Id = Guid.NewGuid(),
        };
    }

    private async Task Create()
    {
        if (_pilot == null)
        {
            return;
        }
        await PilotCommandHandler.CreatePilot(_pilot.Id, _pilot.Firstname, _pilot.Lastname, _pilot.Callsign, string.Empty);

        NavigationManager.NavigateTo($"/pilot/{_pilot.Id}");
    }

    private async Task CreateAndContinue()
    {
        if (_pilot == null)
        {
            return;
        }
        await PilotCommandHandler.CreatePilot(_pilot.Id, _pilot.Firstname, _pilot.Lastname, _pilot.Callsign, string.Empty);

        _pilot = new NaeTime.Client.Models.Pilot()
        {
            Id = Guid.NewGuid(),
        };
        _isValid = false;
    }
}
