@page "/track/create"

@if (_track != null)
{
    <MudGrid Justify=Justify.Center>
        <MudItem xs=3>
            <MudIconButton Icon=@Icons.Material.Filled.ArrowLeft Href="/track/list"></MudIconButton>
            <MudPaper Class="p-4">
                <MudForm @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_track.Name" Label="Name" Required="true"></MudTextField>
                    <MudSelect T="Guid" @bind-Value="_selectedDetector" Label="Add Detector">
                        @foreach (var detector in GetAvailableDetectors())
                        {
                            <MudSelectItem Value="@detector.Id">@detector.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon=@Icons.Material.Filled.Add onclick=AddGate></MudIconButton>
                    <MudList T="string">
                        @foreach(var detector in _track.Detectors)
                        {
                            <MudListItem>
                                <div class="d-flex align-items-center">
                                    <span>@detector.Name</span>
                                    <MudSpacer />
                                    <MudIconButton Disabled="@(!_track.CanMoveDetectorUp(detector.Id))" Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => _track.MoveDetectorUp(detector.Id)"></MudIconButton>
                                    <MudIconButton Disabled="@(!_track.CanMoveDetectorDown(detector.Id))" Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => _track.MoveDetectorDown(detector.Id)"></MudIconButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _track.Detectors.Remove(detector)"></MudIconButton>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    <MudButton Disabled=@(!_isValid) Variant="Variant.Filled" Color="Color.Primary" OnClick="Create">Create</MudButton>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Inject]
    private ITrackCommandHandler TrackCommandHandler { get; set; } = null!;
    [Inject]
    private IHardwareQueryHandler HardwareQueryHandler { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    private Guid _selectedDetector;
    private NaeTime.Client.Models.Track? _track;
    private IEnumerable<NaeTime.Query.Abstractions.Models.Detector> _allDetectors = Enumerable.Empty<NaeTime.Query.Abstractions.Models.Detector>();

    private bool _isValid = false;

    protected override async Task OnInitializedAsync()
    {
        _allDetectors = await HardwareQueryHandler.GetAllDetectors();
        _track = new NaeTime.Client.Models.Track()
        {
            Id = Guid.NewGuid(),
        };
    }
    private IEnumerable<NaeTime.Query.Abstractions.Models.Detector> GetAvailableDetectors()
    {
        if (_track == null)
        {
            return Enumerable.Empty<NaeTime.Query.Abstractions.Models.Detector>();
        }
        var usedDetectorIds = _track.Detectors.Select(d => d.Id).ToHashSet();
        return _allDetectors.Where(d => !usedDetectorIds.Contains(d.Id));
    }
    private void AddGate()
    {
        if(_track == null)
        {
            return;
        }
        if (_selectedDetector == Guid.Empty)
        {
            return;
        }
        NaeTime.Query.Abstractions.Models.Detector? detector = _allDetectors.FirstOrDefault(d => d.Id == _selectedDetector);
        if (detector == null)
        {
            return;
        }
        NaeTime.Client.Models.Detector trackDetector = DetectorProjector.Project(detector);
        _track.Detectors.Add(trackDetector);
    }
    private async Task Create()
    {
        if(_track == null)
        {
            return;
        }

        if(string.IsNullOrWhiteSpace(_track.Name))
        {
            return;
        }

        await TrackCommandHandler.DesignTrack(_track.Id, _track.Name, _track.Detectors.Select(x => x.Id).ToArray());
        NavigationManager.NavigateTo($"/track/{_track.Id}");
    }
}
