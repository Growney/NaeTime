@page "/hardware/immersionrclaprf/ethernet8/create"
@using System.Net

@if(_immersionRCLapRF != null)
{
    <MudGrid Justify=Justify.Center>
        <MudItem xs=3>
            <MudIconButton Icon=@Icons.Material.Filled.ArrowLeft Href="/hardware/list"></MudIconButton>
            <MudPaper Class="p-4">
                <MudForm @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_immersionRCLapRF.Name" Label="Name" Required="true"></MudTextField>
                    <MudTextField @bind-Value="_immersionRCLapRF.IPAddress" Label="IP Address" Required="true"></MudTextField>
                    <MudNumericField T=ushort @bind-Value="_immersionRCLapRF.Port" Label="Port" Required="true" Min="1" Max="65535"></MudNumericField>
                    <MudButton Disabled=@(!_isValid) Variant="Variant.Filled" Color="Color.Primary" OnClick="Create">Create</MudButton>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Inject]
    private IImmersionRCLapRFCommandHandler ImmersionRCLapRFCommandHandler { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private NaeTime.Client.Models.EthernetImmersionRCLapRF? _immersionRCLapRF;

    private bool _isValid = false;

    protected override void OnInitialized()
    {
        _immersionRCLapRF = new NaeTime.Client.Models.EthernetImmersionRCLapRF()
            {
                Id = Guid.NewGuid(),
                Port = 5403,
                IPAddress = "192.168.1.2"
            };
    }

    private async Task Create()
    {
        if(_immersionRCLapRF == null)
        {
            return;
        }

        if(string.IsNullOrEmpty(_immersionRCLapRF.Name))
        {
            return;
        }

        if(!IPAddress.TryParse(_immersionRCLapRF.IPAddress, out IPAddress? parsedAddress))
        {
            return;
        }
        if (_immersionRCLapRF.Port < 1 || _immersionRCLapRF.Port > 65535)
        {
            return;
        }

        await ImmersionRCLapRFCommandHandler.RegisterNetworkLapRF8Channel(_immersionRCLapRF.Id, _immersionRCLapRF.Name, parsedAddress, _immersionRCLapRF.Port);

        NavigationManager.NavigateTo($"/hardware/immersionrclaprf/ethernet8/{_immersionRCLapRF.Id}");
    }
}
