@using NaeTime.Hardware.Frequency
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
<div class="shadow rounded p-2" style="width: 190px">
    @if (!IsCollapsed)
    {
        <table class="w-100">
            <tbody>
                <tr>
                    <td class="align-start" style="width:10px">
                        <SfSwitch TChecked=bool ValueChange="EnabledSwitchChanged"></SfSwitch>
                    </td>
                    <td>
                        <div class="h4 text-start">
                            @Configuration.LaneNumber
                        </div>
                    </td>
                    <td>
                        <div class="h5 text-end">
                            @Configuration.FrequencyInMhz <sup style="font-size:0.5em">MHz</sup>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    }
    <div>
        <SfDropDownButton CssClass="e-primary e-block" Content=@GetPilotString(Configuration.PilotId) >
            <DropDownButtonEvents ItemSelected=PilotSelected></DropDownButtonEvents>
            <DropDownMenuItems>
                @foreach (var pilot in Pilots)
                {
                    <DropDownMenuItem s Id="@(pilot.Id.ToString())" Text="@GetPilotString(pilot.Id)"></DropDownMenuItem>
                }
            </DropDownMenuItems>
        </SfDropDownButton>
    </div>
    @if (!IsCollapsed)
    {
        <div>
            <table class="w-100 mx-auto">
                <tbody>
                    <tr>
                        <td class="w-50">
                            <SfDropDownButton CssClass="e-primary e-block" Content=@GetBandString()>
                                <DropDownButtonEvents ItemSelected=BandSelected></DropDownButtonEvents>
                                <DropDownMenuItems>
                                    @foreach (var band in Band.Bands)
                                    {
                                        <DropDownMenuItem Id="@(band.Id.ToString())" Text=@band.ShortName></DropDownMenuItem>
                                    }
                                </DropDownMenuItems>
                            </SfDropDownButton>
                        </td>
                        <td class="w-50">
                            @if (Band.Bands.Any(x => x.Id == Configuration.BandId))
                            {
                                <SfDropDownButton CssClass="e-link e-block" Content=@GetFrequencyString()>
                                    <DropDownButtonEvents ItemSelected=FrequencySelected></DropDownButtonEvents>
                                    <DropDownMenuItems>
                                        @{
                                            var band = Band.Bands.First(b => b.Id == Configuration.BandId);
                                            foreach (var frequency in band.Frequencies)
                                            {
                                                <DropDownMenuItem Id="@(frequency.FrequencyInMhz.ToString())" Text="@frequency.Name"></DropDownMenuItem>
                                            }
                                        }
                                    </DropDownMenuItems>
                                </SfDropDownButton>
                            }
                            else
                            {
                                <SfNumericTextBox ShowSpinButton=false TValue=int ValueChanged="GoToFrequency" Value="Configuration.FrequencyInMhz" ValueExpression="() => Configuration.FrequencyInMhz"></SfNumericTextBox>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    
    <div class="progress mt-1" style="height: 10px">
        @if (Configuration.MaxRssiValue > 0)
        {
            var percent = (int)((Configuration.RssiValue / Configuration.MaxRssiValue) * 100);
            <div class="progress-bar bg-success" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
        }
        else
        {
            <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        }
    </div>
    <TimerDisplay MaxMilliseconds=MaximumLapMilliseconds Start="Configuration.LapStarted"></TimerDisplay>
    @if (!IsCollapsed)
    {
        <table class="w-100">
            <tbody>
                <tr>
                    <td class="w-50">
                        <SfButton CssClass="e-success w-100 rounded-0 rounded-start" @onclick="() => TriggerDetection(Guid.Empty)"><i class="fa-solid fa-stopwatch"></i></SfButton>
                    </td>
                    <td class="w-50">
                        <SfButton CssClass="e-danger w-100 rounded-0 rounded-end" @onclick="() => TriggerInvalidation(Guid.Empty)"><i class="fa-solid fa-stopwatch"></i></SfButton>
                    </td>
                </tr>
            </tbody>
        </table>
    }
</div>