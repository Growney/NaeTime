@page "/openpractice"
@layout MainLayout
<div class="open-practice-grid">
    @if (!_isLaneConfigCollapsed)
    {
        <div>
            <table class="w-100 mb-2">
                <tr>
                    <td>

                        <h1>Open Practice</h1>
                        <SfDropDownButton Content="Start Session On">
                            <DropDownButtonEvents ItemSelected=TrackSelectedForNewSession></DropDownButtonEvents>
                            <DropDownMenuItems>
                                @foreach (var track in _tracks)
                                {
                                    <DropDownMenuItem Text=@track.Name Id="@track.Id.ToString()" ></DropDownMenuItem>
                                }
                                <DropDownMenuItem Text="[New Track]"></DropDownMenuItem>
                            </DropDownMenuItems>
                        </SfDropDownButton>
                        <SfDropDownButton Content="@GetActiveSessionName()">
                            <DropDownButtonEvents ItemSelected=SessionSelected></DropDownButtonEvents>
                            <DropDownMenuItems>
                                @foreach (var session in _sessionDetails)
                                {
                                    <DropDownMenuItem Text=@session.Name Id="@session.Id.ToString()"></DropDownMenuItem>
                                }
                            </DropDownMenuItems>
                        </SfDropDownButton>
                    </td>
                    @if (_selectedSession != null)
                    {
                        <td class="content-end">
                            <table style="float:right;">
                                <th>
                                    Lap Times (ms)
                                </th>
                                <tr>
                                    <th>
                                        Minimum
                                    </th>
                                    <th>
                                        Maximum
                                    </th>
                                </tr>
                                <tr>
                                    <td>
                                        <SfNumericTextBox ShowSpinButton CssClass="rounded-0 rounded-end" TValue=long ValueChanged="SetSessionMinimumLapTime" Value="_selectedSession.MinimumLapMilliseconds" ValueExpression="() => _selectedSession.MinimumLapMilliseconds"></SfNumericTextBox>
                                    </td>
                                    <td>
                                        <SfNumericTextBox ShowSpinButton CssClass="rounded-0 rounded-end" TValue=long? ValueChanged="SetSessionMaximumLapTime" Value="_selectedSession.MaximumLapMilliseconds" ValueExpression="() => _selectedSession.MaximumLapMilliseconds"></SfNumericTextBox>
                                    </td>
                                </tr>
                            </table>
                        </td>

                    }
                </tr>
            </table>
        
        </div>
    }
    @if (_selectedSession == null)
    {
        <h3>No active session</h3>
    }
    else
    {
        <div>
            @if (_selectedSession.Id == _activeSessionId)
            {
                <div class="lane-container">
                    @foreach (var laneConfiguration in _selectedSession.Lanes)
                    {
                        <SessionLaneConfiguration Pilots="_pilots"
                                                  Configuration="laneConfiguration"
                                                  SessionId="_selectedSession.Id"
                                                  IsCollapsed="_isLaneConfigCollapsed"
                                                  MaximumLapMilliseconds="_selectedSession.MaximumLapMilliseconds">
                        </SessionLaneConfiguration>
                    }
                </div>

                <div>
                    @if (_isLaneConfigCollapsed)
                    {
                        <SfButton CssClass="w-100 p-0" @onclick="@(()=>_isLaneConfigCollapsed = false)"><i class="fa-solid fa-caret-down"></i></SfButton>
                    }
                    else
                    {
                        <SfButton CssClass="w-100 p-0" @onclick="@(()=>_isLaneConfigCollapsed = true)"><i class="fa-solid fa-caret-up"></i></SfButton>
                    }
                </div>
            }
        </div>
        <TrackTuner TrackId=_selectedSession.TrackId></TrackTuner>
        <SessionLapGraph SessionId="_selectedSession.Id"></SessionLapGraph>

        @if (!_isLaneConfigCollapsed)
        {
            <SfSplitButton Content="Add Consecutive Laps Leaderboard">
                <SplitButtonEvents ItemSelected=TrackConsecutiveLapsSelected></SplitButtonEvents>
                <DropDownMenuItems>
                    @{
                        uint[] laps = [2, 3, 4, 5, 6, 7, 8, 9, 10];
                        foreach (var lap in laps)
                        {
                            if (!_selectedSession.TrackedConsecutiveLaps.Any(x => x == lap))
                            {
                                <DropDownMenuItem Id="@(lap.ToString())" Text="@lap.ToString()"></DropDownMenuItem>
                            }
                        }
                    }
                </DropDownMenuItems>
            </SfSplitButton>
        }
        <div class="d-flex flex-wrap justify-content-center">
            <TotalLapsLeaderboard SessionId="_selectedSession.Id"></TotalLapsLeaderboard>
            <AverageLapLeaderboard SessionId="_selectedSession.Id"></AverageLapLeaderboard>
            <SingleLapLeaderboard SessionId="_selectedSession.Id"></SingleLapLeaderboard>

            @foreach (var trackedLapCaps in _selectedSession.TrackedConsecutiveLaps.OrderBy(x => x))
            {
                <ConsecutiveLapsLeaderboard SessionId="_selectedSession.Id" LapCap="trackedLapCaps"></ConsecutiveLapsLeaderboard>
            }
        </div>
        <div class="d-flex flex-wrap justify-content-center">
            @foreach (var pilot in _pilots)
            {
                <PilotLapList SessionId="_selectedSession.Id" PilotId="pilot.Id" PilotName="@pilot.CallSign"></PilotLapList>
            }
        </div>
    }
</div>
